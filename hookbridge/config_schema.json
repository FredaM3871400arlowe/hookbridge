{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HookBridge Configuration",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "default": "0.0.0.0",
      "description": "Host address to bind the relay server."
    },
    "port": {
      "type": "integer",
      "default": 8080,
      "description": "Port to listen on."
    },
    "log_level": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARNING", "ERROR"],
      "default": "INFO"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_path", "target_url"],
        "properties": {
          "name": { "type": "string" },
          "source_path": { "type": "string", "pattern": "^/" },
          "target_url": { "type": "string", "format": "uri" },
          "secret": { "type": "string" },
          "filter_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "operator", "value"],
              "properties": {
                "field": { "type": "string" },
                "operator": { "type": "string", "enum": ["eq", "neq", "contains", "exists"] },
                "value": {}
              }
            }
          },
          "transform": {
            "type": "string",
            "description": "Name of a registered transform function."
          }
        }
      }
    }
  }
}
